# MAILSHIELD Environment Configuration Template
# Copy this file to .env and configure your local settings

# Gemini API Key (Required for online AI reasoning layer)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_key

# Sarvam AI API Key (Required for 22 Indian languages STT & TTS voice)
# Obtain your key from https://sarvam.ai/
SARVAM_API_KEY=your_key

# Reasoning Provider: 'gemini' | 'ollama' | 'rule_based'
REASONING_PROVIDER=gemini

# Ollama Configuration (Only needed if REASONING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database & Authentication
DATABASE_URL=sqlite:///./forensics.db
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_MAILSHIELD_SECRET_2026

# Security & CORS
APP_NAME=MAILSHIELD
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]
MAX_UPLOAD_SIZE_BYTES=20971520

