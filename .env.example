# Copy to .env and adjust for your environment. Never commit real secrets.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=forensics
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=email_forensics

# --- Backend (standalone / local dev) ---
# For local development without docker, SQLite works out of the box:
# DATABASE_URL=sqlite:///./forensics.db
DATABASE_URL=postgresql+psycopg2://forensics:change_me_in_production@localhost:5432/email_forensics

CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_BYTES=10485760
RATE_LIMIT_PER_MINUTE=30

# Comma-free JSON list of your organization's trusted domains for
# lookalike-domain detection, e.g. ["acmecorp.example"]
TRUSTED_ORG_DOMAINS=[]

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
