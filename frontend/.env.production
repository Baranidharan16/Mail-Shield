# Production (Vercel). "/api/v1" is relative: vercel.json rewrites /api/* to the
# Render backend, so the browser talks to ONE origin (first-party cookies, no CORS).
VITE_API_BASE_URL=/api/v1
# Alternative (not recommended — needs cross-site cookies):
# VITE_API_BASE_URL=https://sih-email-forensics-full-1.onrender.com/api/v1
